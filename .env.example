
# Copy to .env and fill in. .env is gitignored: never commit real secrets.
APP_ENV=local
LOG_LEVEL=INFO

# Local docker compose database. Swap for your Neon/Supabase URL in production
DATABSE_URL=postgresql://joblens:joblens@localhost:5432/joblens


# Identify yourself to the sources. Put a real contact address here
USER_AGENT=joblens/1.0


# Optional. Free key from https://developer.adzuna.com
# Without these, the adzuna source is skipped and the pipeline still runs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb