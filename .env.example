
# Copy to .env and fill in. .env is gitignored: never commit real secrets.
APP_ENV=local
LOG_LEVEL=INFO
# Phase 7. "text" for a terminal, "json" for a container whose logs are
# shipped somewhere. The Docker image sets json; override it if you like.
LOG_FORMAT=text
# Largest request body the API accepts. Resumes are capped at 2MB below this.
MAX_BODY_BYTES=3145728

# Local docker compose database. Swap for your Neon/Supabase URL in production
DATABASE_URL=postgresql://joblens:joblens@localhost:5432/joblens


# Identify yourself to the sources. Put a real contact address here
USER_AGENT=joblens/1.0
# Seconds before a request to a job board or the embedding API gives up.
REQUEST_TIMEOUT=20


# Phase 3. The local embedder needs no key and no network after first use.
# EMBEDDER=api only exists to reproduce the local-vs-API comparison.
EMBEDDER=local
CHUNK_STRATEGY=whole
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=

# Phase 4. ollama runs a local model and costs nothing, which is why the
# eval suite can run without a card on file. Switch to anthropic for
# production and set the key.
LLM_BACKEND=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Default completion length for calls that do not set their own, and the
# seconds one LLM call may take. A chat answer from the local 8B model takes
# about 50 seconds on CPU, so the timeout leaves room.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120

# Per-caller budget for /chat and /match. A public URL with an uncapped
# model call behind it is someone else's free inference endpoint.
RATE_LIMIT_PER_MINUTE=10
# Behind a reverse proxy or a PaaS the budget must key on the forwarded
# address, or every user shares one bucket. Name the proxy's address, or "*"
# on a platform where only the platform can reach the container. Unset means
# only 127.0.0.1 may set X-Forwarded-For.
FORWARDED_ALLOW_IPS=
# Load the cross-encoder at startup (about 20s on CPU) rather than inside
# the first reranked search. Set false on a memory-starved host.
RERANK_WARMUP=true
# How long /trends may serve a cached summary.
TRENDS_CACHE_SECONDS=300
# Load the models from the local Hugging Face cache without asking the Hub
# for updates, which saves about 20s per start. Needs both models downloaded
# once first (any search or embed does it); the Docker image sets it itself.
HF_HUB_OFFLINE=0

# Phase 7 monitoring profile. Anonymous admin is for a laptop only.
GRAFANA_ANONYMOUS=true
GRAFANA_ADMIN_PASSWORD=admin

# Phase 6. Which skill extractor the pipeline uses: rules, base, tuned or
# teacher. "rules" is the Phase 2 dictionary and stays the default until the
# comparison table says otherwise.
SKILL_EXTRACTOR=rules
SKILL_ADAPTER_PATH=
